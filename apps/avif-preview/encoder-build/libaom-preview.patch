+  if (!env) return;
+  int y, uv, sharp = -1;
+  if (sscanf(env, "%d,%d,%d", &y, &uv, &sharp) < 2) return;
+  struct loopfilter *const lf = &cpi->common.lf;
+  lf->filter_level[0] = lf->filter_level[1] = y;
+  lf->filter_level_u = lf->filter_level_v = uv;
