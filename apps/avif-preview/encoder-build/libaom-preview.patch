+
+// avifpreview experiment: force a fixed (e.g. low-pass) Wiener filter on every
+// restoration unit of every plane.  AOM_PREVIEW_WIENER="y0,y1,y2/c1,c2" gives
+// the outer taps (units of 1/128); the centre tap is implied.
+static void set_sym_taps(InterpKernel f, int t0, int t1, int t2) {
+  f[0] = f[WIENER_WIN - 1] = (int16_t)t0;
+  f[1] = f[WIENER_WIN - 2] = (int16_t)t1;
+  f[2] = f[WIENER_WIN - 3] = (int16_t)t2;
+  f[3] = (int16_t)(-2 * (t0 + t1 + t2));
+  f[7] = 0;
+}
+
+void av1_pick_filter_restoration(const YV12_BUFFER_CONFIG *src, AV1_COMP *cpi) {
+  pick_filter_restoration(src, cpi);
+  const char *env = getenv("AOM_PREVIEW_WIENER");
+  if (!env) return;
+  int y0, y1, y2, c1 = 0, c2 = 0;
+  const int n = sscanf(env, "%d,%d,%d/%d,%d", &y0, &y1, &y2, &c1, &c2);
+  if (n < 3) return;
+  AV1_COMMON *const cm = &cpi->common;
+  for (int plane = 0; plane < av1_num_planes(cm); ++plane) {
+    RestorationInfo *rsi = &cm->rst_info[plane];
+    const int uv = plane > 0;
+    if (uv && n < 5) continue;  // no chroma taps: leave chroma to the search
+    // One unit per plane (for frames up to 384 px) so the taps are coded once.
+    set_restoration_unit_size(cm, rsi, uv, RESTORATION_UNITSIZE_MAX);
+    rsi->frame_restoration_type = RESTORE_WIENER;
+    for (int u = 0; u < rsi->num_rest_units; ++u) {
+      RestorationUnitInfo *rui = &rsi->unit_info[u];
+      rui->restoration_type = RESTORE_WIENER;
+      set_sym_taps(rui->wiener_info.vfilter, uv ? 0 : y0, uv ? c1 : y1, uv ? c2 : y2);
+      set_sym_taps(rui->wiener_info.hfilter, uv ? 0 : y0, uv ? c1 : y1, uv ? c2 : y2);
+    }
+  }
+}
